# =============================================================================
# SMS — Docker deployment settings.
#
#   cp docker.env.example .env && chmod 600 .env && nano .env
#
# .env is gitignored and excluded from the image by .dockerignore.
#
# FIRST SETUP
#   docker compose build
#   docker compose up -d --wait db
#   docker compose run --rm --no-deps app node_modules/.bin/prisma db push
#   ops/docker/seed-baseline.sh /path/to/baseline.sql
#   docker compose up -d --wait
#
# UPDATES          ops/docker/update.sh
# BACKUP           ops/docker/backup.sh        (cron: 0 3 * * * $HOME/sms/ops/docker/backup.sh)
# RESTORE          CONFIRM=yes ops/docker/restore.sh <db.dump> [files.tar.gz]
# LOGS             docker compose logs -f app
#
# NEVER run `docker compose down -v` — it deletes the database, uploads, logs
# and the TLS certificates.
# =============================================================================

# ---- Required ---------------------------------------------------------------

# The address people type. Must match the Cloudflare DNS record.
SMS_DOMAIN=test.tesek-mak-lef-sms.org

# openssl rand -hex 32   (hex only: it goes inside a URL)
POSTGRES_PASSWORD=

# openssl rand -base64 48
NEXTAUTH_SECRET=

# Cloudflare API token: Zone -> DNS -> Edit, limited to this one zone.
CF_API_TOKEN=

# ---- TLS --------------------------------------------------------------------

# cloudflare = real Let's Encrypt certificate via DNS (the server)
# internal   = self-signed, for testing on a laptop
TLS_MODE=cloudflare

# Which address port 443 listens on. Docker ignores ufw for this port, so while
# the server is LAN-only, set it to the server's LAN IP rather than all addresses.
HTTPS_BIND=0.0.0.0

# ---- Build-time -------------------------------------------------------------

# TEST SERVER ONLY: pins "today" inside the baseline school year (it ended
# 2026-05-08). Remove for production. Baked into the image: rebuild after changing.
NEXT_PUBLIC_TEST_DATE=2026-03-16

# ---- Optional ---------------------------------------------------------------

LOG_LEVEL=info

# Sets this EXISTING user's password on every app start. Use once to get in,
# then delete both lines and run: docker compose up -d app
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
